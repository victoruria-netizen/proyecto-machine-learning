# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Datos restringidos / de gran tamaño (no versionar; ver README)
data/raw/
data/*.csv
data/*.parquet
data/processed/*
!data/processed/.gitkeep
data/*.xlsx
!data/.gitkeep

# Modelos / artefactos pesados
models/*.pkl
models/*.joblib
models/*.h5
!models/.gitkeep

# Salidas locales de prueba de los scripts de train/ (fallback cuando /outputs no existe;
# en el servidor los resultados van a /outputs, fuera del repositorio)
train/outputs_local/

# Credenciales y secretos
*.env
.env
secrets.*
credentials.*

# Sistema operativo / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
